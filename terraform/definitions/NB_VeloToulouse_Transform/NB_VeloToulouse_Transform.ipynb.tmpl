   "id": "e1ef8ef6-a79b-4299-81c1-ef929f93603b"
  },
  {
   "cell_type": "code",
   "source": [
    "latest_path = history_path.rsplit(\"/\", 1)[0] + \"/station_latest\"\n",
    "\n",
    "history_df = DeltaTable(\n",
    "    history_path, storage_options=storage_options\n",
    ").to_pandas()\n",
    "\n",
    "latest = (\n",
    "    history_df\n",
    "    .sort_values(\"collected_at\", ascending=False)\n",
    "    .drop_duplicates(subset=\"station_id\", keep=\"first\")\n",
    ")\n",
    "\n",
    "for column in [\"collected_at\", \"last_reported_at\"]:\n",
    "    latest[column] = latest[column].astype(\"datetime64[us, UTC]\")\n",
    "\n",
    "write_deltalake(\n",
    "    latest_path,\n",
    "    pa.Table.from_pandas(latest, preserve_index=False),\n",
    "    mode=\"overwrite\",\n",
    "    storage_options=storage_options,\n",
    ")\n",
    "\n",
    "print(f\"Stations dans station_latest : {len(latest):,}\")"
   ],
