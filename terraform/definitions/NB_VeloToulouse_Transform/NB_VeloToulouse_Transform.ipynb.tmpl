   },
   "id": "f4f614a9-6ca8-4bff-880a-4577807ba6cb"
  },
  {
   "cell_type": "code",
   "source": [
    "import pyarrow as pa\n",
    "from deltalake import DeltaTable, write_deltalake\n",
    "\n",
    "history_path = table_path.rsplit(\"/\", 1)[0] + \"/station_history\"\n",
    "\n",
    "history_data = clean.copy()\n",
    "for column in [\"collected_at\", \"last_reported_at\"]:\n",
    "    history_data[column] = history_data[column].astype(\"datetime64[us, UTC]\")\n",
    "\n",
    "batch = pa.Table.from_pandas(history_data, preserve_index=False)\n",
    "\n",
    "storage_options = {\n",
    "    \"bearer_token\": notebookutils.credentials.getToken(\"storage\"),\n",
    "    \"use_fabric_endpoint\": \"true\",\n",
    "}\n",
    "\n",
    "if DeltaTable.is_deltatable(history_path, storage_options=storage_options):\n",
    "    history = DeltaTable(history_path, storage_options=storage_options)\n",
    "\n",
    "    metrics = (\n",
    "        history.merge(\n",
    "            source=batch,\n",
    "            source_alias=\"incoming\",\n",
    "            target_alias=\"existing\",\n",
    "            predicate=(\n",
    "                \"existing.station_id = incoming.station_id \"\n",
    "                \"AND existing.collected_at = incoming.collected_at\"\n",
    "            ),\n",
    "        )\n",
    "        .when_not_matched_insert_all()\n",
    "        .execute()\n",
    "    )\n",
    "\n",
    "    print(f\"Nouveaux relevés ajoutés : {metrics['num_target_rows_inserted']:,}\")\n",
    "else:\n",
    "    write_deltalake(\n",
    "        history_path,\n",
    "        batch,\n",
    "        mode=\"error\",\n",
    "        storage_options=storage_options,\n",
    "    )\n",
    "    print(f\"Historique créé avec {batch.num_rows:,} relevés.\")"
   ],
   "outputs": [],
