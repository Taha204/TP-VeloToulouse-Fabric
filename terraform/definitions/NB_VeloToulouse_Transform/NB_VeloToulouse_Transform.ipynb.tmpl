    "import pandas as pd\n",
    "\n",
    "history = DeltaTable(history_path, storage_options=storage_options)\n",
    "station_ids = history.to_pandas(columns=[\"station_id\"])\n",
    "\n",
    "display(pd.DataFrame({\n",
    "    \"nombre_de_releves\": [len(station_ids)],\n",
    "    \"nombre_de_stations\": [station_ids[\"station_id\"].nunique()],\n",
    "}))"
   ],
