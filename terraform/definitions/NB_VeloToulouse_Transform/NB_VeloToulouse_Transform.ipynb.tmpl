   },
   "id": "b318b1c8-f9b1-4618-b641-76d43a7f602d"
  },
  {
   "cell_type": "code",
   "source": [
    "import pandas as pd\n",
    "\n",
    "clean = df.copy()\n",
    "\n",
    "clean[\"station_id\"] = clean[\"station_id\"].astype(\"string\").str.strip()\n",
    "clean[\"collected_at\"] = pd.to_datetime(\n",
    "    clean[\"collected_at\"], format=\"ISO8601\", utc=True, errors=\"coerce\"\n",
    ")\n",
    "clean[\"last_reported_at\"] = pd.to_datetime(\n",
    "    clean[\"last_reported\"].where(clean[\"last_reported\"] > 0),\n",
    "    unit=\"s\",\n",
    "    utc=True,\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "valid = (\n",
    "    clean[\"station_id\"].fillna(\"\").ne(\"\")\n",
    "    & clean[\"station_id\"].ne(\"TEST001\")\n",
    "    & clean[\"collected_at\"].notna()\n",
    "    & clean[\"num_bikes_available\"].ge(0)\n",
    "    & clean[\"num_docks_available\"].ge(0)\n",
    ")\n",
    "\n",
    "clean = clean.loc[valid].drop_duplicates(\n",
    "    subset=[\"station_id\", \"collected_at\"]\n",
    ")\n",
    "\n",
    "print(f\"Lignes conservées : {len(clean)} / {len(df)}\")\n",
    "display(clean[[\"station_id\", \"collected_at\", \"last_reported_at\", \"num_bikes_available\"]])"
   ],
   "outputs": [],
   "execution_count": null,
   "metadata": {
