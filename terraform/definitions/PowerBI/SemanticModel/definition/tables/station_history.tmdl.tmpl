table station_history
	lineageTag: 8da0686c-146e-4e64-8ce1-9763a1c8c716

	measure 'Stations par relevé' =
			
			DISTINCTCOUNT('station_history'[station_id])
		formatString: 0
		lineageTag: 6daed7b0-1f65-4039-a570-3cf62fd2abe0

	measure 'Vélos disponibles historique' =
			
			IF(
			    [Stations par relevé] = 466,
			    SUM('station_history'[num_bikes_available]),
			    BLANK()
			)
		formatString: 0
		lineageTag: 51939ab8-8b89-42c9-85dd-a202752d3dd3

	measure 'Vélos historiques test' =
			
			VAR NbStations =
			    DISTINCTCOUNT('station_history'[station_id])
			
			VAR NbVelos =
			    SUM('station_history'[num_bikes_available])
			
			RETURN
			    IF(
			        HASONEVALUE('station_history'[collected_at])
			            && NbStations = 466,
			        NbVelos,
			        BLANK()
			    )
		formatString: 0
		lineageTag: efc29c13-b75d-4087-b10d-073ad3fb56d1

	measure 'Vélos historiques filtrés' =
			
			VAR StationsDuReleve =
			    CALCULATE(
			        DISTINCTCOUNT('station_history'[station_id]),
			        REMOVEFILTERS('station_latest')
			    )
			
			VAR VelosDisponibles =
			    SUM('station_history'[num_bikes_available])
			
			RETURN
			    IF(
			        HASONEVALUE('station_history'[collected_at])
			            && StationsDuReleve = 466,
			        VelosDisponibles,
			        BLANK()
			    )
		formatString: 0
		lineageTag: 6abd3810-f634-4107-9f6f-9df5dbcd62ed

	measure 'Dernier relevé actuel' =
			
			MAX('station_latest'[collected_at])
		formatString: General Date
		lineageTag: 2a3ffbe7-af49-4d9a-809d-859fdbd134ba

	measure 'Dernier relevé historique' =
			
			MAX('station_history'[collected_at])
		formatString: General Date
		lineageTag: df122675-f892-4c59-92bb-93332d6f81a5

